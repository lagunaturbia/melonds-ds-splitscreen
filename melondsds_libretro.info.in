# Software Information
display_name = "Nintendo - DS (${MELONDSDS_NAME})"
display_version = "${MELONDSDS_VERSION}"
description = "Two to four locally linked Nintendo DS consoles side by side in one RetroArch window, each with its own gamepad and saves."
authors = "Jesse Talavera|The melonDS Team"
categories = "Emulator"
corename = "${MELONDSDS_NAME}"
license = "GPLv3+"
supported_extensions = "nds|ids"

# Hardware Information
manufacturer = "Nintendo"
systemname = "Nintendo DS"
systemid = "nds"

# Libretro Features
cheats = "false"
core_options = "true"
core_options_version = "2.0"
database = "Nintendo - Nintendo DS"
hw_render = "false"
input_descriptors = "false"
is_experimental = "true"
libretro_saves = "false"
load_subsystem = "false"
needs_fullpath = "false"
savestate = "false"
single_purpose = "false"
supports_no_game = "false"

# Firmware / BIOS
firmware_count = 3
firmware0_desc = "firmware.bin (NDS Firmware)"
firmware0_path = "firmware.bin"
firmware0_opt = "true"
firmware1_desc = "bios7.bin (ARM7 BIOS)"
firmware1_path = "bios7.bin"
firmware1_opt = "true"
firmware2_desc = "bios9.bin (ARM9 BIOS)"
firmware2_path = "bios9.bin"
firmware2_opt = "true"
notes = "(!) bios7.bin (md5): df692a80a5b1bc90728bc3dfc76cd948|(!) bios9.bin (md5): a392174eb3e572fed6447e956bde4b25"